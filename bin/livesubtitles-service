#!/usr/bin/env bash
# Live Subtitles service launcher (used by the systemd unit).
set -euo pipefail
VENV="${LS_VENV:-$HOME/.local/share/livesubtitles/venv}"
BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "livesubtitles: venv missing at $VENV — run install.sh first" >&2
  exit 1
fi

exec "$VENV/bin/python" "$BASE/livesubtitles/service.py" "$@"
